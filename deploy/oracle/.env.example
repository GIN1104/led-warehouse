# Скопируйте в .env на VM и заполните. Не коммитьте .env.
# chmod 600 .env

# FQDN с A-записью на public IP VM (нужен для Let's Encrypt / HTTPS).
API_DOMAIN=api.example.com

# Email для ACME (Let's Encrypt) в Caddy.
ACME_EMAIL=you@example.com

# Turso (тот же ledvision, что был на Fly). Значения только здесь / в vault — не в git/чате.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Опционально: доп. CORS origins через запятую (gin1104.github.io уже в коде).
# ACCESS_CORS_ORIGINS=

# Опционально Telegram (сервер только).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_IDS=
