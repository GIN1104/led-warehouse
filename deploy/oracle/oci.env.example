# Для scripts/oci-create-arm-vm.sh. Скопируйте в oci.env (gitignore).
# Значения — из OCI Console; не коммитьте.

# Обязательные OCID
COMPARTMENT_ID=ocid1.compartment.oc1..REPLACE
SUBNET_ID=ocid1.subnet.oc1..REPLACE
# Availability domain, например Eu-Frankfurt-1-AD-1 (oci iam availability-domain list)
AVAILABILITY_DOMAIN=REPLACE-AD

# SSH public key path
SSH_PUBLIC_KEY_PATH=~/.ssh/id_rsa.pub

# Опционально
DISPLAY_NAME=led-warehouse-api
# Shape Always Free ARM
SHAPE=VM.Standard.A1.Flex
OCPUS=1
MEMORY_IN_GBS=6
# Ubuntu aarch64 image OCID для вашего region (Console → Compute → Images)
IMAGE_ID=ocid1.image.oc1..REPLACE
