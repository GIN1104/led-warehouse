# Общий учёт на этом сервере (Docker / npm run dev). Пусто = только браузер.
NEXT_PUBLIC_SHARED=1

# Путь для GitHub Pages (build:pages задаёт /led-warehouse).
# NEXT_PUBLIC_BASE_PATH=/led-warehouse

# Google OAuth Web Client ID (публичный). Client secret и пароль аккаунта сюда не класть.
# Аккаунт проекта: ledvision2026.il@gmail.com (Calendar + Drive).
# Authorized JavaScript origins:
#   http://localhost:3000
#   https://gin1104.github.io
# Authorized redirect URIs (GIS Token Client / popup):
#   http://localhost:3000/
#   http://localhost:3000/calendar/
#   https://gin1104.github.io/led-warehouse/
#   https://gin1104.github.io/led-warehouse/calendar/
NEXT_PUBLIC_GOOGLE_CLIENT_ID=821406929437-le4vbhpvf8b0khkpdhid8s0fu47bgn3o.apps.googleusercontent.com

# Общая база в Turso (libSQL). Пусто = только файл data/warehouse.sqlite.
# Токен только на сервере (Docker / npm start), не в GitHub Pages.
# TURSO_DATABASE_URL=libsql://led-warehouse-ВАША-ОРГ.turso.io
# TURSO_AUTH_TOKEN=
# Локальный mock без облака (token не нужен):
# TURSO_DATABASE_URL=file:./data/turso-mock.db
#
# CORS для Pages → этот API host (через запятую, сверх gin1104.github.io / localhost):
# ACCESS_CORS_ORIGINS=https://preview.example.com


# Telegram Bot API (только сервер Docker / npm run dev). На GitHub Pages не задавать —
# уведомления пишутся в telegram_outbox как mock. Токен от @BotFather.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Chat id админов для access-request notify (через запятую), если в /me ещё нет chatId.
# TELEGRAM_ADMIN_CHAT_IDS=123456789,987654321

# Pages → shared access API (опционально). Пусто = только локальная IndexedDB на Pages.
# На Docker с NEXT_PUBLIC_SHARED=1 достаточно same-origin /api/v1/access-requests.
# NEXT_PUBLIC_ACCESS_API_BASE=https://your-docker-host.example.com

# Optional one-way Google Sheets / Apps Script mirror (не source of truth).
# Source of truth = Docker SQLite / Turso. Без URL — POST /api/v1/sheets/mirror → mock.
# SHEETS_MIRROR_WEBHOOK_URL=https://script.google.com/macros/s/…/exec
