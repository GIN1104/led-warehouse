# Общий учёт на этом сервере (Docker / npm run dev). Пусто = только браузер.
NEXT_PUBLIC_SHARED=1

# Путь для GitHub Pages (build:pages задаёт /led-warehouse).
# NEXT_PUBLIC_BASE_PATH=/led-warehouse

# Google OAuth Web Client ID (публичный). Client secret и пароль аккаунта сюда не класть.
# Аккаунт проекта: ledvision2026.il@gmail.com (Calendar + Drive).
# Authorized JavaScript origins:
#   http://localhost:3000
#   https://gin1104.github.io
# Authorized redirect URIs (GIS Token Client / popup):
#   http://localhost:3000/
#   http://localhost:3000/calendar/
#   https://gin1104.github.io/led-warehouse/
#   https://gin1104.github.io/led-warehouse/calendar/
NEXT_PUBLIC_GOOGLE_CLIENT_ID=821406929437-le4vbhpvf8b0khkpdhid8s0fu47bgn3o.apps.googleusercontent.com

# Общая база в Turso (libSQL). Пусто = только файл data/warehouse.sqlite.
# Токен только на сервере (Docker / npm start), не в GitHub Pages.
# DB name: ledvision. Реальный URL/token — только в .env.local, не коммитить.
# TURSO_DATABASE_URL=libsql://ledvision-….turso.io
# TURSO_AUTH_TOKEN=
# Локальный mock без облака (token не нужен):
# TURSO_DATABASE_URL=file:./data/turso-mock.db
#
# CORS для Pages → этот API host (через запятую, сверх gin1104.github.io / localhost):
# ACCESS_CORS_ORIGINS=https://preview.example.com


# Telegram Bot API (только сервер Docker / Oracle VM / npm run dev). На GitHub Pages не задавать —
# уведомления пишутся в telegram_outbox как mock. Токен от @BotFather.
# События: access_request, shortage, transfer, order_phase.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Chat id админов (через запятую), если в /me ещё нет chatId.
# TELEGRAM_ADMIN_CHAT_IDS=123456789,987654321
# Oracle: положите в deploy/oracle/.env на VM (см. deploy/oracle/README.md).

# Pages → shared access API (опционально). Пусто = только локальная IndexedDB на Pages.
# На Docker с NEXT_PUBLIC_SHARED=1 достаточно same-origin /api/v1/access-requests.
# GitHub Variable NEXT_PUBLIC_ACCESS_API_BASE=https://<api-host>
# Временно (Render Free): https://<service>.onrender.com — см. docs/render-free-api.md
# Потом Oracle: https://<oracle-api-domain> — см. deploy/oracle/README.md
# NEXT_PUBLIC_ACCESS_API_BASE=https://your-docker-host.example.com

# Optional one-way Google Sheets / Apps Script mirror (не source of truth).
# Source of truth = Docker SQLite / Turso. Без URL — POST /api/v1/sheets/mirror → mock.
# SHEETS_MIRROR_WEBHOOK_URL=https://script.google.com/macros/s/…/exec

# Apps Script «Выезды» / Files. Пусто = только складской /files.
# Deep-link: {URL}?trip={orderId}&view=files — tripId ↔ orderId.
# Полный клон (предпочтительно): appscript/led-trips/
# NEXT_PUBLIC_LED_TRIPS_GAS_EXEC_URL=https://script.google.com/macros/s/AKfycbz5uYj8rlCNVav48GIhHgLuKvpKDYEP9g0Z-th-RVHT7JAiWPOvYZHX_gfUF0bmIx9F/exec
# Узкий Files-only (fallback): appscript/trip-files/
# NEXT_PUBLIC_TRIP_FILES_GAS_EXEC_URL=https://script.google.com/macros/s/AKfycbzM6OTwuBKCJ3sLHVJdVHIiQH2lf2EYHGtilE4KxWmNAo6K-ZQe4xejW_RvqoPEdoLE/exec

# --- Backup Turso/SQLite → Google Drive (сервер: Render / Fly / Oracle) ---
# См. docs/backup-restore.md. Без secrets — mock в data/backups-mock/drive/.
# Папка Drive — на аккаунте LED Vision (ledvision2026), share Editor на SA email.
# Restore UI только starchenkogin@gmail.com (не ledvision2026.il@gmail.com).
# Cloudflare R2 не используем.
# Drive (service account JSON + folder shared to SA; GIS browser token не для cron):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_DRIVE_BACKUP_FOLDER_ID=
# Cron script scripts/backup-to-drive без owner email:
# BACKUP_CRON_SECRET=
# BACKUP_API_URL=https://led-warehouse-api.onrender.com

